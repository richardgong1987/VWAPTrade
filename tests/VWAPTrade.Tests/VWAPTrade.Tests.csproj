<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The cBot project does not enable nullable analysis; linked cBot sources are compiled
         here under the same rules so they do not raise warnings they never raise in the cBot. -->
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <!-- Unit tests for the cBot's pure (cAlgo-free) logic. The classes under test are LINKED in
       below (never a ProjectReference) so the tests never pull in the cTrader.Automate /
       cAlgo.API dependency. Only cAlgo-free files may be linked here. -->
  <ItemGroup Label="Behavior under test">
    <Compile Include="..\..\VWAPTrade\Orders\OrderPlanner.cs" Link="Orders\OrderPlanner.cs" />
    <Compile Include="..\..\VWAPTrade\Orders\TradeResultR.cs" Link="Orders\TradeResultR.cs" />
    <Compile Include="..\..\VWAPTrade\Risk\RiskGuard.cs" Link="Risk\RiskGuard.cs" />
    <Compile Include="..\..\VWAPTrade\OrderLogger\TradeCsvMigrator.cs" Link="OrderLogger\TradeCsvMigrator.cs" />
    <Compile Include="..\..\VWAPTrade\OrderLogger\TradeCsvSchema.cs" Link="OrderLogger\TradeCsvSchema.cs" />
    <Compile Include="..\..\VWAPTrade\Vwap\VwapCalculator.cs" Link="Vwap\VwapCalculator.cs" />
    <Compile Include="..\..\VWAPTrade\Vwap\VwapStack.cs" Link="Vwap\VwapStack.cs" />
    <Compile Include="..\..\VWAPTrade\Vwap\TradingSession.cs" Link="Vwap\TradingSession.cs" />
    <Compile Include="..\..\VWAPTrade\Biz\MainBiz.cs" Link="Biz\MainBiz.cs" />
    <Compile Include="..\..\VWAPTrade\Signals\HanJinSignals26.cs" Link="Signals\HanJinSignals26.cs" />
    <Compile Include="..\..\VWAPTrade\Utils\Utils.cs" Link="Utils\Utils.cs" />
  </ItemGroup>

  <!-- Data models the planner depends on. CAlgoSymbolModel is intentionally excluded: it is the
       only Models/ file that references cAlgo.API. -->
  <ItemGroup Label="Models under test">
    <Compile Include="..\..\VWAPTrade\Models\SignalModel.cs" Link="Models\SignalModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\VwapSampleModel.cs" Link="Models\VwapSampleModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\TradeSettingsModel.cs" Link="Models\TradeSettingsModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\VwapStrongReadingModel.cs" Link="Models\VwapStrongReadingModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\CandleModel.cs" Link="Models\CandleModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\HanJinSignalScanModel.cs" Link="Models\HanJinSignalScanModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\HanJinSignalOptionsModel.cs" Link="Models\HanJinSignalOptionsModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\SignalFamilyModel.cs" Link="Models\SignalFamilyModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\SignalSideModel.cs" Link="Models\SignalSideModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\TradeLevelModel.cs" Link="Models\TradeLevelModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\OrderPlanModel.cs" Link="Models\OrderPlanModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\TradeDirectionModel.cs" Link="Models\TradeDirectionModel.cs" />
    <Compile Include="..\..\VWAPTrade\Models\ISymbolModel.cs" Link="Models\ISymbolModel.cs" />
  </ItemGroup>

</Project>
